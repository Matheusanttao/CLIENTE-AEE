# =============================================================================
# M-ECOMMERCE — variaveis de ambiente (VALORES FICTICIOS)
# Copie para .env ou configure no painel da Vercel. Nunca commite .env real.
# =============================================================================

# --- Frontend (Vite: qualquer VITE_* vai para o bundle do navegador) ---
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica
# Alternativa ao ANON_KEY (publishable key do dashboard Supabase):
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

VITE_MP_PUBLIC_KEY=TEST-public-key-mercado-pago
VITE_CLOUDINARY_CLOUD_NAME=seu-cloud-name
VITE_WHATSAPP_NUMBER=5531999999999

# Loja em modo demonstracao (compras/login desativados). false = loja aberta.
VITE_STORE_DEMO_MODE=true
STORE_DEMO_MODE=true

# --- Servidor apenas (Vercel /api — NUNCA use prefixo VITE_) ---
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta
# Alternativa nova nomenclatura Supabase:
# SUPABASE_SECRET_KEY=sb_secret_xxx

MP_ACCESS_TOKEN=TEST-access-token-mercado-pago
MP_WEBHOOK_SECRET=seu-webhook-secret-mercado-pago

CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=sua-cloudinary-api-secret
CLOUDINARY_CLOUD_NAME=seu-cloud-name

RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="Loja <noreply@seudominio.com.br>"

APP_URL=https://seudominio.com.br
PASSWORD_RESET_SECRET=troque-por-string-longa-aleatoria

# Obrigatorio em producao. A Vercel Cron envia Authorization: Bearer <CRON_SECRET>
CRON_SECRET=troque-por-string-longa-aleatoria

SUPERFRETE_TOKEN=seu-token-superfrete
SUPERFRETE_ORIGIN_CEP=32500000
SUPERFRETE_ENV=sandbox
SUPERFRETE_WEBHOOK_TOKEN=token-opcional-query
SUPERFRETE_WEBHOOK_SECRET=hmac-secret-opcional
# SUPERFRETE_SERVICES=
# SUPERFRETE_USER_AGENT=
# SUPERFRETE_PLATFORM=
# SUPERFRETE_FROM_NAME=
# SUPERFRETE_FROM_PHONE=
# SUPERFRETE_FROM_EMAIL=
# SUPERFRETE_FROM_DOCUMENT=
